    "db:generate": "pnpm dlx prisma@7.8.0 generate --schema packages/db-config/prisma/schema.prisma"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  }
}